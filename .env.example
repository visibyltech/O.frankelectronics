# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.

# Firebase service account for THIS store's own Firebase project (Firebase
# console > Project settings > Service accounts > Generate new private key).
# Use a separate project from any other store so orders and customers stay apart.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Keep the \n sequences, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=""

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Used only by `npm run db:seed-admin` to create the first admin account.
# This is a one-time, server-side script, not an API route.
ADMIN_NAME="Admin"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Klump (Buy Now, Pay Later). Both are needed for the Klump checkout option.
# Get them from the Klump merchant dashboard (business.useklump.com).
# Client-side widget key: must be prefixed NEXT_PUBLIC_ to reach the browser.
NEXT_PUBLIC_KLUMP_PUBLIC_KEY=""
# Server-side key, used only to verify a payment with Klump.
KLUMP_SECRET_KEY=""
